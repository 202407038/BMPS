{
  "name": "bmps",
  "version": "0.1.0",
  "private": true,
  "description": "익명 브레인스토밍·마인드맵 협업 시스템",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run check && npm test && npm run build",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "demo": "npm run dev",
    "seed": "npm run seed --workspace @bmps/demo-seed",
    "dev:server": "npm run dev --workspace @bmps/server",
    "dev:web": "npm run dev --workspace @bmps/web"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.0.0"
  }
}
